# Kopiere diese Datei nach config/.env und trage vorhandene Zugänge ein.
# config/.env wird NIE committet (siehe .gitignore). Niemals Passwörter oder
# Keys im Klartext an anderer Stelle im Repo speichern (Kostenregel/Sicherheitsregel).

# --- Bestehende, bereits bezahlte Abos (nur innerhalb ihres Leistungsumfangs nutzen) ---
GROK_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
OPENAI_API_KEY=

# --- Google Drive (Ziel-Upload-Ordner) ---
GOOGLE_DRIVE_TARGET_FOLDER_ID=

# --- Optional: Hermes Gateway für Statusmeldungen/Freigabeanfragen ---
HERMES_NOTIFY_CHANNEL=

# --- Lokale Modelle (falls konfiguriert, siehe docs/LOCAL_FALLBACKS.md) ---
LOCAL_LLM_ENDPOINT=
LOCAL_TTS_MODEL_PATH=
LOCAL_IMAGE_MODEL_PATH=
LOCAL_VIDEO_MODEL_PATH=
